<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0.0</Version>
    <Authors>itzkitb</Authors>
    <PackageProjectUrl>https://github.com/itzkitb/butterbror2</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ButterBror.Core/ButterBror.Core.csproj" />
    <ProjectReference Include="../ButterBror.Infrastructure/ButterBror.Infrastructure.csproj" />
    <ProjectReference Include="../ButterBror.Domain/ButterBror.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="StackExchange.Redis" Version="3.1.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed HTML pages as resources -->
    <EmbeddedResource Include="Pages/*.html" />
  </ItemGroup>

</Project>
